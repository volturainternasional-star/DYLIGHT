rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'volturainternasional@gmail.com' ||
        request.auth.uid == 'volturainternasional@gmail.com'
      );
    }

    // User progress, completed modules, streak, and portfolio
    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      match /completed_modules/{moduleId} {
        allow read, write: if true;
      }

      match /portfolio/{recordId} {
        allow read, write: if true;
      }

      match /activities/{activityId} {
        allow read, write: if true;
      }
    }

    // Shared threat intelligence & security tools catalog
    match /security_tools/{toolId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
